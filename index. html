                specs: "BH 89%, Fullset Original, Mulus No Minus",
                image: "https://images.unsplash.com/photo-1592750475338-74b7b21085ab?auto=format&fit=crop&w=600&q=80"
            },
            {
                id: 5,
                brand: "OPPO",
                name: "OPPO Reno 11 Pro 5G",
                condition: "Baru (BNIB)",
                price: 8999000,
                specs: "12GB RAM, 512GB ROM, Portrait Expert",
                image: "https://images.unsplash.com/photo-1598327105666-5b89351aff97?auto=format&fit=crop&w=600&q=80"
            },
            {
                id: 6,
                brand: "Vivo",
                name: "Vivo V30 Pro 5G",
                condition: "Baru (BNIB)",
                price: 6999000,
                specs: "ZEISS Camera, Aura Light, 80W FlashCharge",
                image: "https://images.unsplash.com/photo-1565849904461-04a58ad377e0?auto=format&fit=crop&w=600&q=80"
            },
            {
                id: 7,
                brand: "Realme",
                name: "Realme 12 Pro+ 5G",
                condition: "Baru (BNIB)",
                price: 5499000,
                specs: "Periscope Portrait Lens, Snapdragon 7s Gen 2",
                image: "https://images.unsplash.com/photo-1580910051074-3eb694886505?auto=format&fit=crop&w=600&q=80"
            },
            {
                id: 8,
                brand: "Samsung",
                name: "Samsung Galaxy A55 5G",
                condition: "Baru (BNIB)",
                price: 5999000,
                specs: "Exynos 1480, Metal Frame, IP67 Water Resistance",
                image: "https://images.unsplash.com/photo-1585060544812-6b45742d762f?auto=format&fit=crop&w=600&q=80"
            }
        ];

        // Application State
        let phones = JSON.parse(localStorage.getItem('phoneStoreData')) || initialPhones;
        let cart = [];
        let selectedBrand = "Semua";
        let isAdminMode = false;

        // Initialize App
        window.addEventListener('DOMContentLoaded', () => {
            renderBrandFilters();
            renderProducts();
            updateCartBadge();
        });

        // Save data to localStorage
        function saveToStorage() {
            localStorage.setItem('phoneStoreData', JSON.stringify(phones));
        }

        // Format Number to IDR Currency
        function formatRupiah(number) {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(number);
        }

        // Render Brand Filter Buttons
        function renderBrandFilters() {
            const brands = ["Semua", "iPhone", "Samsung", "Xiaomi", "OPPO", "Vivo", "Realme"];
            const container = document.getElementById('brandFilters');
            
            container.innerHTML = brands.map(brand => `
                <button onclick="setBrandFilter('${brand}')" class="px-4 py-1.5 rounded-xl font-medium transition whitespace-nowrap text-xs ${
                    selectedBrand === brand 
                        ? 'bg-brand-600 text-white shadow-md shadow-blue-500/20' 
                        : 'bg-slate-100 hover:bg-slate-200 text-slate-600'
                }">
                    ${brand === "Semua" ? '<i class="fa-solid fa-layer-group mr-1"></i>' : ''}${brand}
                </button>
            `).join('');
        }

        // Change Selected Brand Filter
        function setBrandFilter(brand) {
            selectedBrand = brand;
            renderBrandFilters();
            renderProducts();
        }

        // Reset All Filters
        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('sortSelect').value = 'default';
            selectedBrand = "Semua";
            renderBrandFilters();
            renderProducts();
        }

        // Toggle Admin/Management Mode (Show/Hide Add & Delete Buttons)
        function toggleAdminMode() {
            isAdminMode = !isAdminMode;
            const adminBadge = document.getElementById('adminBadge');
            const addPhoneNavBtn = document.getElementById('addPhoneNavBtn');
            const adminToggleBtn = document.getElementById('adminToggleBtn');

            if (isAdminMode) {
                adminBadge.classList.remove('hidden');
                addPhoneNavBtn.classList.remove('hidden');
                adminToggleBtn.classList.add('bg-amber-500', 'text-white', 'border-amber-500');
                showToast("Mode Kelola Etalase Aktif! Anda bisa menambah/menghapus HP.", "info");
            } else {
                adminBadge.classList.add('hidden');
                addPhoneNavBtn.classList.add('hidden');
                adminToggleBtn.classList.remove('bg-amber-500', 'text-white', 'border-amber-500');
                showToast("Keluar dari Mode Kelola.", "info");
            }

            renderProducts();
        }

        // Filter and Render Products Grid
        function renderProducts() {
            const searchQuery = document.getElementById('searchInput').value.toLowerCase().trim();
            const sortOption = document.getElementById('sortSelect').value;

            // Filter List
            let filtered = phones.filter(phone => {
                const matchesBrand = selectedBrand === "Semua" || phone.brand.toLowerCase() === selectedBrand.toLowerCase();
                const matchesSearch = phone.name.toLowerCase().includes(searchQuery) || 
                                      phone.specs.toLowerCase().includes(searchQuery) ||
                                      phone.brand.toLowerCase().includes(searchQuery);
                return matchesBrand && matchesSearch;
            });

            // Sorting
            if (sortOption === 'low') {
                filtered.sort((a, b) => a.price - b.price);
            } else if (sortOption === 'high') {
                filtered.sort((a, b) => b.price - a.price);
            }

            // Update product counter
            document.getElementById('productCount').textContent = filtered.length;

            const grid = document.getElementById('productGrid');
            const emptyState = document.getElementById('emptyState');

            if (filtered.length === 0) {
                grid.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');

            grid.innerHTML = filtered.map(phone => {
                const defaultImg = "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&fit=crop&w=600&q=80";
                const imgSrc = phone.image && phone.image.trim() !== "" ? phone.image : defaultImg;

                return `
                <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group relative">
                    
                    ${isAdminMode ? `
                        <button onclick="deletePhone(${phone.id})" title="Hapus HP dari etalase" class="absolute top-3 right-3 bg-red-600 hover:bg-red-700 text-white p-2 rounded-xl text-xs z-10 shadow-lg transition">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    ` : ''}

                    <div>
                        <!-- Product Image -->
                        <div class="h-48 bg-slate-100 overflow-hidden relative flex items-center justify-center p-4">
                            <img src="${imgSrc}" alt="${phone.name}" 
                                 onerror="this.onerror=null; this.src='${defaultImg}';" 
                                 class="max-h-full object-contain group-hover:scale-105 transition duration-300">
                            
                            <span class="absolute bottom-3 left-3 bg-slate-900/80 backdrop-blur-sm text-white text-[10px] font-semibold px-2.5 py-1 rounded-md">
                                ${phone.condition}
                            </span>
                        </div>

                        <!-- Product Content -->
                        <div class="p-4">
                            <div class="text-xs font-bold text-brand-600 uppercase tracking-wider mb-1">${phone.brand}</div>
                            <h3 class="font-bold text-slate-900 text-base line-clamp-1 group-hover:text-brand-600 transition">${phone.name}</h3>
                            <p class="text-xs text-slate-500 mt-1 line-clamp-2 min-h-[32px]">${phone.specs}</p>
                            
                            <div class="mt-4 pt-3 border-t border-slate-100 flex items-baseline justify-between">
                                <div>
                                    <span class="text-[10px] text-slate-400 block font-medium">Harga Terbaik</span>
                                    <span class="text-lg font-extrabold text-slate-900">${formatRupiah(phone.price)}</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card Actions -->
                    <div class="p-4 pt-0">
                        <button onclick="addToCart(${phone.id})" class="w-full bg-slate-900 hover:bg-brand-600 text-white text-xs font-bold py-2.5 rounded-xl transition flex items-center justify-center space-x-2">
                            <i class="fa-solid fa-cart-plus"></i>
                            <span>Tambah ke Keranjang</span>
                        </button>
                    </div>

                </div>
            `}).join('');
        }

        // Add Phone to Catalog (Etalase)
        function handleAddPhone(e) {
            e.preventDefault();

            const brand = document.getElementById('addBrand').value;
            const name = document.getElementById('addName').value.trim();
            const condition = document.getElementById('addCondition').value;
            const price = parseInt(document.getElementById('addPrice').value);
            const specs = document.getElementById('addSpecs').value.trim();
            const image = document.getElementById('addImage').value.trim();

            if (!brand || !name || isNaN(price)) {
                showToast("Mohon lengkapi data HP!", "error");
                return;
            }

            const newPhone = {
                id: Date.now(),
                brand,
                name,
                condition,
                price,
                specs,
                image
            };

            phones.unshift(newPhone);
            saveToStorage();
            renderProducts();
            closeAddModal();
            showToast(`${name} berhasil ditambahkan ke etalase!`, "success");
            
            // Reset form
            document.getElementById('addPhoneForm').reset();
        }

        // Delete Phone from Catalog
        function deletePhone(id) {
            const phone = phones.find(p => p.id === id);
            if (!phone) return;

            if (confirm(`Apakah Anda yakin ingin menghapus "${phone.name}" dari etalase toko?`)) {
                phones = phones.filter(p => p.id !== id);
                // Remove from cart if present
                cart = cart.filter(item => item.id !== id);
                updateCartBadge();
                saveToStorage();
                renderProducts();
                showToast(`Handphone berhasil dihapus dari etalase.`, "info");
            }
        }

        // Cart Actions
        function addToCart(phoneId) {
            const phone = phones.find(p => p.id === phoneId);
            if (!phone) return;

            const existingIndex = cart.findIndex(item => item.id === phoneId);
            if (existingIndex > -1) {
                cart[existingIndex].qty += 1;
            } else {
                cart.push({ ...phone, qty: 1 });
            }

            updateCartBadge();
            showToast(`${phone.name} dimasukkan ke keranjang.`, "success");
        }

        function updateCartQty(phoneId, change) {
            const index = cart.findIndex(item => item.id === phoneId);
            if (index > -1) {
                cart[index].qty += change;
                if (cart[index].qty <= 0) {
                    cart.splice(index, 1);
                }
            }
            updateCartBadge();
            renderCartContent();
        }

        function removeFromCart(phoneId) {
            cart = cart.filter(item => item.id !== phoneId);
            updateCartBadge();
            renderCartContent();
            showToast("Item dihapus dari keranjang.", "info");
        }

        function updateCartBadge() {
            const totalItems = cart.reduce((sum, item) => sum + item.qty, 0);
            document.getElementById('cartBadge').textContent = totalItems;
        }

        // Render Cart Modal Body
        function renderCartContent() {
            const container = document.getElementById('cartContent');
            const footer = document.getElementById('cartFooter');

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-10">
                        <i class="fa-solid fa-basket-shopping text-4xl text-slate-300 mb-2"></i>
                        <p class="text-slate-500 font-medium text-sm">Keranjang belanja Anda masih kosong.</p>
                    </div>
                `;
                footer.classList.add('hidden');
                return;
            }

            footer.classList.remove('hidden');

            let total = 0;
            container.innerHTML = cart.map(item => {
                const subtotal = item.price * item.qty;
                total += subtotal;
                return `
                    <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200 space-x-3">
                        <div class="flex-1 min-w-0">
                            <h4 class="font-bold text-slate-800 text-sm truncate">${item.name}</h4>
                            <p class="text-xs text-slate-500">${formatRupiah(item.price)} x ${item.qty}</p>
                            <span class="text-xs font-extrabold text-brand-600">${formatRupiah(subtotal)}</span>
                        </div>

                        <!-- Quantity Controls -->
                        <div class="flex items-center space-x-2">
                            <div class="flex items-center bg-white rounded-lg border border-slate-300">
                                <button onclick="updateCartQty(${item.id}, -1)" class="px-2 py-1 text-slate-600 hover:bg-slate-100 rounded-l-lg text-xs font-bold">-</button>
                                <span class="px-2 text-xs font-bold text-slate-800">${item.qty}</span>
                                <button onclick="updateCartQty(${item.id}, 1)" class="px-2 py-1 text-slate-600 hover:bg-slate-100 rounded-r-lg text-xs font-bold">+</button>
                            </div>

                            <button onclick="removeFromCart(${item.id})" class="text-red-500 hover:text-red-700 p-1 text-xs">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            document.getElementById('cartTotalPrice').textContent = formatRupiah(total);
        }

        // WhatsApp Checkout Logic
        function checkoutToWhatsApp() {
            if (cart.length === 0) {
                showToast("Keranjang Anda kosong!", "error");
                return;
            }

            const name = document.getElementById('custName').value.trim();
            const city = document.getElementById('custCity').value.trim();
            const payment = document.getElementById('paymentMethod').value;

            if (!name || !city) {
                showToast("Mohon isi Nama Lengkap dan Kota/Alamat Anda!", "error");
                return;
            }

            let grandTotal = 0;
            let itemsListStr = "";

            cart.forEach((item, index) => {
                const subtotal = item.price * item.qty;
                grandTotal += subtotal;
                itemsListStr += `${index + 1}. *${item.name}*\n   - Qty: ${item.qty} pcs\n   - Harga Satuan: ${formatRupiah(item.price)}\n   - Subtotal: ${formatRupiah(subtotal)}\n\n`;
            });

            // Construct WhatsApp Message
            let text = `Halo Admin *PhoneStore*, saya ingin memesan Handphone berikut:\n\n`;
            text += `📋 *DETAIL PESANAN:* \n${itemsListStr}`;
            text += `💰 *TOTAL PEMBAYARAN:* ${formatRupiah(grandTotal)}\n`;
            text += `💳 *METODE PEMBAYARAN:* ${payment}\n\n`;
            text += `👤 *DATA PEMBELI:*\n`;
            text += `- Nama: ${name}\n`;
            text += `- Alamat/Kota: ${city}\n\n`;
            text += `Mohon konfirmasi ketersediaan stok dan instruksi pembayaran via ${payment}. Terima kasih!`;

            // Encode URL for WhatsApp
            const encodedText = encodeURIComponent(text);
            const waUrl = `https://wa.me/${SELLER_WA_NUMBER}?text=${encodedText}`;

            // Open WhatsApp in new tab
            window.open(waUrl, '_blank');
        }

        // Modal Control Functions
        function openAddModal() {
            document.getElementById('addModal').classList.remove('hidden');
        }

        function closeAddModal() {
            document.getElementById('addModal').classList.add('hidden');
        }

        function openCartModal() {
            renderCartContent();
            document.getElementById('cartModal').classList.remove('hidden');
        }

        function closeCartModal() {
            document.getElementById('cartModal').classList.add('hidden');
        }

        // Toast Notification System
        function showToast(message, type = "success") {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMessage');
            const toastIcon = document.getElementById('toastIcon');

            toastMsg.textContent = message;

            if (type === "error") {
                toastIcon.className = "fa-solid fa-circle-xmark text-red-400 text-lg";
            } else if (type === "info") {
                toastIcon.className = "fa-solid fa-circle-info text-blue-400 text-lg";
            } else {
                toastIcon.className = "fa-solid fa-circle-check text-emerald-400 text-lg";
            }

            toast.classList.remove('translate-y-20', 'opacity-0');

            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
</html>
